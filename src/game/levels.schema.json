{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jam-shift:levels:v1",
  "title": "Jam Shift campaign level manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaults", "levels"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaults": { "$ref": "#/$defs/defaults" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/level" }
    }
  },
  "$defs": {
    "spawnWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "weight"],
      "properties": {
        "color": { "type": "integer", "minimum": 0, "maximum": 5 },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "spawnWeights": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/spawnWeight" }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "columns", "spawnWeights"],
      "properties": {
        "rows": { "type": "integer", "minimum": 3, "maximum": 16 },
        "columns": { "type": "integer", "minimum": 3, "maximum": 16 },
        "spawnWeights": { "$ref": "#/$defs/spawnWeights" }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetAmount"],
      "properties": {
        "type": { "enum": ["score", "collect", "jelly", "boss", "shell", "special"] },
        "targetAmount": { "type": "integer", "minimum": 1 },
        "color": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "collect" } }, "required": ["type"] },
          "then": { "required": ["color"] }
        }
      ]
    },
    "boss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "epithet", "color", "maxHealth", "taunt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "epithet": { "type": "string", "minLength": 1 },
        "color": { "type": "integer", "minimum": 0, "maximum": 5 },
        "maxHealth": { "type": "integer", "minimum": 1 },
        "taunt": { "type": "string", "minLength": 1 }
      }
    },
    "initialCell": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 5 },
        { "const": "J" }
      ]
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levelId", "chapter", "chapterName", "maxMoves", "targetScore", "objectives"],
      "properties": {
        "levelId": { "type": "integer", "minimum": 1, "maximum": 100 },
        "chapter": { "type": "integer", "minimum": 1, "maximum": 10 },
        "chapterName": { "type": "string", "minLength": 1 },
        "rows": { "type": "integer", "minimum": 3, "maximum": 16 },
        "columns": { "type": "integer", "minimum": 3, "maximum": 16 },
        "maxMoves": { "type": "integer", "minimum": 1 },
        "targetScore": { "type": "integer", "minimum": 1 },
        "goalColor": { "type": "integer", "minimum": 0, "maximum": 5 },
        "objectives": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/objective" } },
        "spawnWeights": { "$ref": "#/$defs/spawnWeights" },
        "initialGrid": {
          "type": "array",
          "minItems": 3,
          "maxItems": 16,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 16,
            "items": { "$ref": "#/$defs/initialCell" }
          }
        },
        "boss": { "$ref": "#/$defs/boss" }
      },
      "allOf": [
        {
          "if": { "properties": { "objectives": { "contains": { "properties": { "type": { "const": "boss" } }, "required": ["type"] } } }, "required": ["objectives"] },
          "then": { "required": ["boss"] }
        },
        {
          "if": { "required": ["boss"] },
          "then": { "properties": { "objectives": { "contains": { "properties": { "type": { "const": "boss" } }, "required": ["type"] } } } }
        }
      ]
    }
  }
}
